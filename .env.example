# MOVIE_DIR / MOVIE_4K_DIR / TV_SHOW_DIR seed your first libraries on the very
# first run only. After that, directories are managed on the Options page and
# stored in server/data.db — editing them here has no further effect.
MOVIE_DIR=C:\path\to\your\movies
MOVIE_4K_DIR=C:\path\to\your\movies 4k
TV_SHOW_DIR=C:\path\to\your\tv shows
TMDB_API_KEY=your_tmdb_api_key_here
PORT=3001
TV_MATCH_MIN_POPULARITY=5
